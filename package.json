{
  "name": "@doitian/dsh-provider-aliyun",
  "version": "0.2.0",
  "description": "Aliyun DashScope (Bailian) model provider for DeepSeek Harness: registers an `aliyun` route whose model list comes from the configured endpoint itself, with a shipped fallback catalog for capacities and offline use.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "aliyun",
    "aliyuncs",
    "dashscope",
    "bailian",
    "qwen",
    "model-discovery",
    "llm",
    "provider"
  ],
  "license": "MIT",
  "author": "doitian",
  "homepage": "https://github.com/doitian/dsh-provider-aliyun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doitian/dsh-provider-aliyun.git"
  },
  "bugs": {
    "url": "https://github.com/doitian/dsh-provider-aliyun/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./catalog": "./lib/catalog.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/adapter.js",
    "lib/catalog.js",
    "lib/discovery.js",
    "lib/metadata.json",
    "lib/models.js",
    "lib/provider.js",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "probe": "node scripts/probe.mjs",
    "generate:metadata": "node scripts/generate-metadata.mjs",
    "test": "node --test",
    "prepack": "npm run validate && npm run test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@earendil-works/pi-ai": "0.87.1",
    "js-yaml": "^4.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
